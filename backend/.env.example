# Spotify OAuth credentials — create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Must exactly match a Redirect URI registered on your Spotify app
SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# Qdrant vector database (Qdrant Cloud or self-hosted)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# Comma-separated list of browser origins allowed to call this API (CORS).
# Leave unset to use the built-in defaults (prod Vercel URL + localhost).
ALLOWED_ORIGINS=https://catch-a-vibe-six.vercel.app,http://localhost:5173
